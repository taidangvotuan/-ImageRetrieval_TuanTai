# Video Intelligence – sao chép thành .env và chỉnh nếu cần.
# Đường dẫn tương đối được tính từ thư mục gốc repo.

# --- Dataset
VI_DATASET_DIR=dataset
VI_DATASET_NAME=VideoIntelligence-Music
VI_DATASET_VERSION=0.1.0
# Video ngắn hơn ngưỡng này bị cảnh báo too_short (600 giây = 10 phút).
VI_MIN_VIDEO_DURATION_SEC=600
VI_VIDEO_EXTENSIONS=.mp4,.avi,.mkv,.mov
# Domain: chỉ video ca nhạc. Video có category khác bị cảnh báo out_of_domain
# (lỗi khi validate --strict). Để trống "VI_ALLOWED_CATEGORIES=" để bỏ giới hạn.
VI_ALLOWED_CATEGORIES=music_show,music_video,concert

# --- Logging
VI_LOG_DIR=logs
VI_LOG_LEVEL=INFO
