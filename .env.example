# Video Intelligence – sao chép thành .env và chỉnh nếu cần.
# Đường dẫn tương đối được tính từ thư mục gốc repo.

# --- Dataset
VI_DATASET_DIR=dataset
VI_DATASET_NAME=VideoIntelligence-MV
VI_VIDEO_ID_PREFIX=MV_
# Các mốc quy mô Dataset (chỉ tính video accepted).
VI_TARGET_MILESTONES=5,10,30,50
# Video gỡ khỏi dataset được chuyển vào đây (ngoài dataset/, bị .gitignore).
VI_ARCHIVE_DIR=archive

# --- Tiêu chí Dataset: nguồn DUY NHẤT là config/dataset_criteria.json
# (thời lượng 150–420 s, MP4, >= 720p, luật loại trừ). Chỉ bỏ comment khi cần thử nghiệm tạm thời –
# giá trị ở đây GHI ĐÈ file tiêu chí và khiến tài liệu/báo cáo khác với tiêu chuẩn chung.
# VI_MIN_VIDEO_DURATION_SEC=150
# VI_MAX_VIDEO_DURATION_SEC=420
# VI_MIN_LONG_SIDE_PX=1280
# VI_CRITERIA_FILE=config/dataset_criteria.json
# Thư mục lexicon kiểm duyệt nội dung (mặc định lấy từ dataset_criteria.json)
# VI_LEXICON_DIR=config/moderation/lexicons

# --- Logging
VI_LOG_DIR=logs
VI_LOG_LEVEL=INFO

# --- Các giai đoạn sau (chưa dùng, sẽ bổ sung khi triển khai)
# VI_SAMPLING_FPS=1              # GĐ3: 1 frame/giây (thử nghiệm 2)
# VI_CONFIDENCE_THRESHOLD=0.35   # GĐ4
# VI_GAP_TOLERANCE_SEC=2         # GĐ4–5
# VI_KAFKA_BOOTSTRAP=localhost:9092   # GĐ6 (Docker)
# VI_HDFS_URI=hdfs://localhost:9000   # GĐ5–6 (Docker)
