    "auto_reject": {
      "_comment": "Nguồn được phép TỰ ĐỘNG loại khi khớp từ KHÔNG mơ hồ (level=strong). Mô tả chỉ gắn cờ. audio_transcript và visual chỉ gắn cờ cho tới khi được hiệu chỉnh (M5). age_restricted: reject | review.",
      "metadata_fields": [
        "title",
        "source_title",
        "filename",
        "tags"
      ],
      "ocr_min_frames": 2,
      "age_restricted": "reject"
    },
    "language_detection": {
      "_comment": "Dưới ngưỡng tin cậy hoặc văn bản quá ngắn -> 'unknown' (không đoán). Ngôn ngữ không có lexicon -> 'unsupported'.",
      "min_confidence": 0.5,
      "min_letters": 12
    },
    "text_variants": {
      "_comment": "Khử cách viết né bộ lọc trước khi so khớp lexicon.",
      "leet_map": {
        "0": "o",
        "1": "i",
        "3": "e",
        "4": "a",
        "5": "s",
        "7": "t",
        "@": "a",
        "$": "s",
        "!": "i"
      },
      "max_repeat": 2,
      "join_spaced_letters": true
    },
    "methods_not_implemented": {
      "_comment": "Bước chưa triển khai luôn trả 'unknown' với method 'not_implemented' – không giả lập kết quả.",
      "audio_transcript": "M3",
      "visual": "M4"
    },
    "subtitles": {
      "_comment": "Phụ đề YouTube (M2): mọi phụ đề do người đăng cung cấp + phụ đề tự động CHỈ của ngôn ngữ gốc (bỏ bản dịch máy). Chỉ gắn cờ, không tự loại. Lưu trong dataset/moderation/subtitles/ (không commit).",
      "format": "vtt",
      "include_automatic": true,
      "exclude_languages": [
        "live_chat"
      ]
    },
    "ocr": {
      "_comment": "OCR chữ trên khung hình (M2) bằng EasyOCR trên frame lấy mẫu; bỏ qua frame gần giống frame đã đọc (không đổi cảnh). Chữ ngoài các ngôn ngữ OCR (vd. Thái, Hàn) không đọc được -> unknown. Lấy mẫu KHÔNG đảm bảo bắt được chữ xuất hiện rất ngắn.",
      "languages": [
        "vi",
        "en"
      ],
      "sample_every_sec": 2.0,
      "max_width": 960,
      "min_text_confidence": 0.4,
      "dedup_threshold": 6.0,
      "unreadable_ratio_for_unknown": 0.3
    }
  }
